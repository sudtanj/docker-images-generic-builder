# Copy to .env and fill in what you have. The only requirement is at least
# one provider key.
#
#   cp .env.example .env
#   docker compose -f docker-compose.hub.yml up -d

# --- Provider keys -----------------------------------------------------------
# A key on its own is enough: mini-router already knows these providers' URLs
# and which dialect each one speaks. Delete the ones you do not use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Also recognised with no further configuration:
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=

# --- Your own key ------------------------------------------------------------
# What your clients present to mini-router - not a provider key. Required
# because the compose files set MINI_ROUTER_REQUIRE_AUTH=true.
# Generate one:  openssl rand -hex 32
# Comma-separated for more than one.
MINI_ROUTER_API_KEYS=

# --- Anything else -----------------------------------------------------------
# A provider that is not on the list above, or a self-hosted model server:
# MINI_ROUTER_PROVIDER_LOCAL_URL=http://ollama:11434/v1
# MINI_ROUTER_PROVIDER_LOCAL_MAX_CONCURRENCY=1
#
# Point a known provider somewhere else (a gateway, a proxy, Azure):
# MINI_ROUTER_PROVIDER_OPENAI_URL=https://my-gateway.internal/v1
#
# `docker compose run --rm mini-router --help` lists every variable.
